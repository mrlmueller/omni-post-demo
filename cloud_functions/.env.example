# Zugangsdaten der Cloud Functions. Werden zur Laufzeit als Umgebungsvariablen
# gesetzt (Cloud Functions: --set-env-vars bzw. Secret Manager).
# Der Schluessel fuer die Token-Verschluesselung liegt nicht hier, sondern im
# Google Secret Manager (Secret "encryption-key" des Projekts).
# Die Next.js-App hat ihre eigene Liste in der .env.example im Repo-Root.

TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FUNCTION_SHARED_SECRET=
